<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.oracle.database.selectai</groupId>
    <artifactId>select-ai</artifactId>
    <version>1.0.0</version>
    <name>Oracle Select AI for Java</name>
    <description>Java SDK for Oracle Autonomous AI Database's Select AI operations backed by DBMS_CLOUD_AI.</description>
    <packaging>jar</packaging>
    <url>https://github.com/oracle/java-select-ai</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>Oracle</name>
        <url>https://www.oracle.com</url>
    </organization>

    <licenses>
        <license>
            <name>Universal Permissive License v1.0</name>
            <url>https://oss.oracle.com/licenses/upl/</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Dhavalkumar M. Patel</name>
            <email>dhavalkumar.m.patel@oracle.com</email>
            <organization>Oracle</organization>
            <organizationUrl>https://www.oracle.com</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/oracle/java-select-ai.git</connection>
        <developerConnection>scm:git:https://github.com/oracle/java-select-ai.git</developerConnection>
        <url>https://github.com/oracle/java-select-ai</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/oracle/java-select-ai/issues</url>
    </issueManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.plugin.version>3.11.0</maven.compiler.plugin.version>
        <maven.source.plugin.version>3.3.1</maven.source.plugin.version>
        <slf4j.version>2.0.17</slf4j.version>
        <ojdbc11.version>23.26.1.0.0</ojdbc11.version>
        <jackson-databind-core>2.22.2</jackson-databind-core>
        <junit.jupiter.version>5.10.3</junit.jupiter.version>
        <mockito.version>5.11.0</mockito.version>
        <assertj.version>3.27.7</assertj.version>
        <maven.surefire.plugin.version>3.2.5</maven.surefire.plugin.version>
        <maven.javadoc.plugin.version>3.12.0</maven.javadoc.plugin.version>
        <maven.antrun.plugin.version>3.1.0</maven.antrun.plugin.version>
        <java.release.version>17</java.release.version>
        <org.slf4j.simpleLogger.log.com.oracle.database.selectai.impl>off</org.slf4j.simpleLogger.log.com.oracle.database.selectai.impl>
        <org.slf4j.simpleLogger.log.com.oracle.database.selectai.integration>off</org.slf4j.simpleLogger.log.com.oracle.database.selectai.integration>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>${ojdbc11.version}</version>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.security</groupId>
            <artifactId>oraclepki</artifactId>
            <version>${ojdbc11.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson-databind-core}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <profiles>
        <profile>
            <id>samples</id>
            <dependencies>
                <dependency>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                    <version>${slf4j.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <release>${java.release.version}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven.source.plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven.javadoc.plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <doclint>none</doclint>
                    <quiet>true</quiet>
                    <notimestamp>true</notimestamp>
                    <linksource>true</linksource>
                    <release>${java.release.version}</release>
                    <sourcepath>${project.basedir}/src/main/java${path.separator}${project.basedir}/samples/src/main/java</sourcepath>
                    <overview>${project.basedir}/src/main/javadoc/overview.html</overview>
                    <excludePackageNames>com.oracle.database.selectai.impl:com.oracle.database.selectai.samples*</excludePackageNames>
                    <groups>
                        <group>
                            <title>SDK API</title>
                            <packages>com.oracle.database.selectai:com.oracle.database.selectai.model</packages>
                        </group>
                    </groups>
                    <doctitle>Oracle&amp;reg; Select AI for Java</doctitle>
                    <windowtitle>Oracle Select AI for Java</windowtitle>
                    <header>Oracle&amp;reg; Select AI for Java</header>
                    <bottom>Copyright &#169; 2026. All rights reserved.</bottom>
                    <outputDirectory>${project.basedir}/doc</outputDirectory>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${maven.antrun.plugin.version}</version>
                <executions>
                    <execution>
                        <id>copy-legal-documents-to-main-jar</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.outputDirectory}/META-INF"/>
                                <copy file="${project.basedir}/LICENSE.txt"
                                      tofile="${project.build.outputDirectory}/META-INF/LICENSE"/>
                                <copy file="${project.basedir}/THIRD_PARTY_LICENSES.txt"
                                      tofile="${project.build.outputDirectory}/META-INF/THIRD-PARTY_LICENSE"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-legal-documents-to-classifier-jars</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/legal/META-INF"/>
                                <copy file="${project.basedir}/LICENSE.txt"
                                      tofile="${project.build.directory}/legal/META-INF/LICENSE"/>
                                <copy file="${project.basedir}/THIRD_PARTY_LICENSES.txt"
                                      tofile="${project.build.directory}/legal/META-INF/THIRD-PARTY_LICENSE"/>
                                <zip destfile="${project.build.directory}/${project.build.finalName}-sources.jar"
                                     update="true">
                                    <zipfileset dir="${project.build.directory}/legal/META-INF"
                                                 prefix="META-INF"/>
                                </zip>
                                <zip destfile="${project.build.directory}/${project.build.finalName}-javadoc.jar"
                                     update="true">
                                    <zipfileset dir="${project.build.directory}/legal/META-INF"
                                                 prefix="META-INF"/>
                                </zip>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <org.slf4j.simpleLogger.log.com.oracle.database.selectai.impl>
                            ${org.slf4j.simpleLogger.log.com.oracle.database.selectai.impl}
                        </org.slf4j.simpleLogger.log.com.oracle.database.selectai.impl>
                        <org.slf4j.simpleLogger.log.com.oracle.database.selectai.integration>
                            ${org.slf4j.simpleLogger.log.com.oracle.database.selectai.integration}
                        </org.slf4j.simpleLogger.log.com.oracle.database.selectai.integration>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
